#!/usr/bin/env bash
#SPDX-License-Identifier: MIT-0
#
# repos.sh - Push, pull, or status for all git repos in a folder (uses PAT)
#
# Usage:
#   repos.sh status              # Show git status for all repos
#   repos.sh pull                # Pull latest (uses PAT if GH_PAT set)
#   repos.sh push                # Push changes (uses PAT if GH_PAT set)
#   repos.sh push -m "msg"       # Push with commit (stages all, commits, pushes)
#   repos.sh -d /path/to/repos status
#
# PAT: Set GH_PAT for push/pull, or embed one in the origin URL.
# GitHub redirects strip a token from the URL, so the script passes it
# through a credential helper and ignores the gh helper for that command.
#   export GH_PAT='github_pat_...'
#   ./repos.sh pull
#

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
readonly SCRIPT_DIR

usage() {
    cat <<EOF
Usage: $SCRIPT_NAME [-d DIR] {status|pull|push} [-m "msg"]

Actions:
  status    Show git status for each repo
  pull      Git pull (rebase) in each repo (uses PAT if GH_PAT set)
  push      Add -A, commit (if changes), push in each repo (uses PAT if GH_PAT set)
            -m "msg"  Commit message (default: "Update")

Options:
  -d DIR    Directory containing git repos (may be repeated). Default: ansible + bash under tekne.
  -h        Show this help

Environment:
  GH_PAT    GitHub Personal Access Token for push/pull authentication.
            When set, it is used instead of a token embedded in the origin URL
            and instead of the gh credential helper.

Examples:
  export GH_PAT='github_pat_...'
  $SCRIPT_NAME status
  $SCRIPT_NAME pull
  $SCRIPT_NAME push
  $SCRIPT_NAME push -m "Fix haproxy config"
  $SCRIPT_NAME -d /path/to/repos pull
  $SCRIPT_NAME pull                    # default: ansible + bash under tekne
EOF
    exit 0
}

# Parse -d and -h
# Default: ansible and bash under tekne (parent of bash/bin)
TEKNE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
REPOS_DIRS=()
while getopts "d:h" opt; do
    case "$opt" in
        d) REPOS_DIRS+=("$OPTARG") ;;
        h) usage ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
# If no -d was given, default to both ansible and bash
if [[ ${#REPOS_DIRS[@]} -eq 0 ]]; then
    REPOS_DIRS=("$TEKNE_ROOT/ansible" "$TEKNE_ROOT/bash")
fi

ACTION="${1:-}"
shift || true

# Optional -m "msg" for push (commit message)
COMMIT_MSG="Update"
if [[ "$ACTION" == "push" && "${1:-}" == "-m" && -n "${2:-}" ]]; then
    COMMIT_MSG="$2"
    shift 2
fi

if [[ -z "$ACTION" ]]; then
    echo "ERROR: Action required (status, pull, push)." >&2
    usage
fi

case "$ACTION" in
    status | pull | push) ;;
    *)
        echo "ERROR: Invalid action '$ACTION'. Use status, pull, or push." >&2
        exit 1
        ;;
esac

for dir in "${REPOS_DIRS[@]}"; do
    if [[ ! -d "$dir" ]]; then
        echo "ERROR: Directory not found: $dir" >&2
        exit 1
    fi
done

# Find all dirs that contain .git (given dir if it is a repo, then recursive subdirs)
find_repos() {
    local dir="$1"
    local sub
    if [[ -d "${dir}/.git" ]]; then
        echo "$dir"
    fi
    for sub in "$dir"/*/; do
        [[ -d "$sub" ]] || continue
        if [[ -d "${sub}.git" ]]; then
            echo "$sub"
        else
            find_repos "$sub"
        fi
    done
}

# Token embedded in an https origin URL: https://TOKEN@host or https://user:TOKEN@host
origin_token() {
    local url="$1"
    local userinfo
    if [[ "$url" =~ ^https://([^/@]+)@ ]]; then
        userinfo="${BASH_REMATCH[1]}"
        if [[ "$userinfo" == *:* ]]; then
            printf '%s\n' "${userinfo#*:}"
        else
            printf '%s\n' "$userinfo"
        fi
        return 0
    fi
    return 1
}

# Use GH_PAT, or a token already stored in origin, for this git command.
# A URL token is dropped when Git follows GitHub's redirect, and the gh
# credential helper would then authenticate as a different account.
run_with_pat() {
    local repo_dir="$1"
    shift
    local cmd=("$@")
    local origin_url token

    origin_url="$(git -C "$repo_dir" remote get-url origin 2>/dev/null || true)"
    token="${GH_PAT:-}"
    if [[ -z "$token" ]]; then
        token="$(origin_token "$origin_url" || true)"
    fi

    if [[ -n "$token" ]]; then
        (
            cd "$repo_dir"
            export GH_PUSH_TOKEN="$token"
            # Config is passed in the environment so "git push" is not run as "git git push".
            # $GH_PUSH_TOKEN must stay literal here; the helper expands it when git runs.
            export GIT_CONFIG_COUNT=2
            export GIT_CONFIG_KEY_0=credential.helper
            export GIT_CONFIG_VALUE_0=
            export GIT_CONFIG_KEY_1=credential.https://github.com.helper
            # shellcheck disable=SC2016
            export GIT_CONFIG_VALUE_1='!f() { echo username=x-access-token; echo "password=$GH_PUSH_TOKEN"; }; f'
            "${cmd[@]}"
        )
    else
        (cd "$repo_dir" && "${cmd[@]}")
    fi
}

main() {
    local repos=()
    local dir r
    for dir in "${REPOS_DIRS[@]}"; do
        while IFS= read -r r; do
            [[ -n "$r" ]] && repos+=("$r")
        done < <(find_repos "$dir")
    done
    # Dedupe by path (in case a repo appears under multiple roots)
    mapfile -t repos < <(printf '%s\n' "${repos[@]}" | sort -u)

    if [[ ${#repos[@]} -eq 0 ]]; then
        echo "No git repositories found in: ${REPOS_DIRS[*]}"
        exit 0
    fi

    echo "Found ${#repos[@]} repo(s) in: ${REPOS_DIRS[*]}"
    echo ""

    for repo in "${repos[@]}"; do
        name="$(basename "$repo")"
        echo "=== $name ==="

        case "$ACTION" in
            status)
                (cd "$repo" && git status -s)
                ;;
            pull)
                run_with_pat "$repo" git pull --rebase
                ;;
            push)
                (cd "$repo" && git add -A && { git diff --staged --quiet || git commit -m "$COMMIT_MSG"; })
                run_with_pat "$repo" git push
                ;;
        esac
        echo ""
    done
}

main
