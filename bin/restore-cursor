#!/bin/bash

pgrep -af /usr/share/cursor && {
    echo "Quit Cursor first"
    exit 1
}
archive=$(find /srv/OneDrive/Documents/Backups/cursor -maxdepth 1 -name 'cursor-profile-*.tar.zst' -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
stage=$(mktemp -d)
tar -C "$stage" -I zstd -xf "$archive"
mkdir -p ~/.config/Cursor/User ~/.cursor
cp -a "$stage/Cursor/User/." ~/.config/Cursor/User/
cp -a "$stage/cursor/." ~/.cursor/
rm -rf "$stage"
echo "Restored $archive"
