#!/bin/bash
set -euo pipefail

pgrep -af /usr/share/cursor && {
    echo "Quit Cursor first"
    exit 1
}
archive=$(find /srv/OneDrive/Archive/cursor -maxdepth 1 -name 'cursor-profile-*.tar.zst' -printf '%T@ %p\n' | sort -nr | head -1 | cut -d' ' -f2-)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
tar -C "$stage" -I zstd -xf "$archive"
mkdir -p ~/.config/Cursor/User ~/.cursor
# Git pack files are mode 0444. cp cannot overwrite them in place.
cp -a --remove-destination "$stage/Cursor/User/." ~/.config/Cursor/User/
cp -a --remove-destination "$stage/cursor/." ~/.cursor/
echo "Restored $archive"
